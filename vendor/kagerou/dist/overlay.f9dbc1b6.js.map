    const setFooterVisibility = function setFooterVisibility() {
        let r = false;
        const f = window.config.get('footer');
        for(let _ in f){
            if (_ === 'recover') continue;
            const el = $(`.footer-${_}`, 0);
            if (f[_]) el.classList.remove('hidden');
            else {
                el.classList.add('hidden');
                r = true;
            }
        }
