                }
            }
            const foot = document.querySelector('.footer-rdps > small');
            if (foot) foot.textContent = replay ? "\u56DE\u653E \xb7 \u4F30\u7B97" : attribution?.updating ? "DPS \xb7 \u5F52\u56E0\u66F4\u65B0\u4E2D" : attribution?.retained ? "\u5DF2\u4FDD\u7559 \xb7 \u4F30\u7B97" : window.renderer.current === '1' ? "\u771F\u6C14 DPS" : attribution?.status === 'estimated' ? "DPS \xb7 \u5F52\u56E0\u4F30\u7B97" : 'DPS';
