            document.querySelector('.yysls-notice').textContent = rdpsText + " \xb7 " + qiText + (s.labelsFromScreenshot ? " \xb7 \u540D\u5B57\u4F9D\u622A\u56FE\u5339\u914D" : '');
            document.querySelector('.yysls-notice').title = [
                ...attribution?.limitations || [],
