                ].includes(snap.health?.status);
                const estimated = enc?.durationBasis === 'local-statistic-start-estimate';
                const stateTimed = enc?.durationBasis === 'server-battle-state-received';
                status = bad ? "\u91C7\u96C6\u5DF2\u4E2D\u65AD\uFF0C\u4FDD\u7559\u4E0A\u6B21\u7ED3\u679C" : enc ? enc.finalized ? "\u6218\u6597\u5DF2\u7ED3\u7B97 \xb7 \u4F7F\u7528\u670D\u52A1\u5668\u65F6\u957F" : enc.clockEnded ? "\u6218\u6597\u5DF2\u7ED3\u675F \xb7 \u7B49\u5F85\u7ED3\u7B97\u6821\u51C6" : stateTimed ? "\u5B9E\u65F6 DPS \xb7 \u6309\u670D\u52A1\u5668\u5F00\u6218\u72B6\u6001\u8BA1\u65F6" : estimated ? "\u5B9E\u65F6\u4F30\u7B97 DPS \xb7 \u6309\u9996\u7B14\u4F24\u5BB3\u8BA1\u65F6" : "\u7D2F\u8BA1\u4F24\u5BB3\u66F4\u65B0\u4E2D \xb7 \u7F3A\u5C11\u5F00\u6218\u65F6\u95F4" : "\u5DF2\u8FDE\u63A5 \xb7 \u7B49\u5F85\u6218\u6597";
                if (enc?.retained) status = "\u6218\u6597\u5DF2\u7ED3\u675F \xb7 " + (enc.finalized ? "\u4FDD\u7559\u7ED3\u7B97\u7ED3\u679C" : stateTimed ? "\u4FDD\u7559\u63A5\u6536\u65F6\u95F4\u8BA1\u65F6\u7ED3\u679C" : "\u4FDD\u7559\u4F30\u7B97\u7ED3\u679C");
                if (!bad && snap.health?.stale && enc && !enc.finalized && !enc.retained && !enc.clockEnded) status = "\u7B49\u5F85\u7EDF\u8BA1\u66F4\u65B0 \xb7 \u8BA1\u65F6\u5DF2\u6682\u505C";
                if (bad) status = "\u6570\u636E\u4E2D\u65AD / \u4F1A\u8BDD\u5931\u6548\uFF0C\u4FDD\u7559\u4E0A\u6B21\u7ED3\u679C";
                if (snap.health?.status === 'stopped') status = "\u91C7\u96C6\u5DF2\u505C\u6B62 \xb7 \u4FDD\u7559\u7ED3\u679C";
                status += ` \xb7 \u{5DF2}\u{89C2}\u{6D4B} ${enc?.actors.length || snap.actors?.length || 0} \u{4EBA}`;
                if (snap.health?.status === 'waiting' && !enc && !bad) status = "\u91C7\u96C6\u8FDE\u63A5\u6B63\u5E38 \xb7 \u526F\u672C\u5916\u7B49\u5F85\u7EDF\u8BA1";
                if (snap.coverage?.knownAcquisitionGaps?.length) status += " \xb7 \u672C\u8F6E\u9010\u51FB\u6709\u91C7\u96C6\u7F3A\u53E3";
